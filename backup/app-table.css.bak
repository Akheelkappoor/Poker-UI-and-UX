:root {
  --table-bg0: #061e14;
  --table-bg1: #073020;
  --table-bg2: #0a4a31;
}

.table-page {
  width: min(1200px, calc(100% - 40px));
  margin: 22px auto 34px;
  padding: 0;
}

.table-page .table-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.table-page .topbar {
  position: relative;
  border-radius: 22px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.06),
    rgba(255, 255, 255, 0.02)
  );
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(14px);
  padding: 16px 18px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  overflow: hidden;
}

.table-page .topbar::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
      600px 240px at 10% -10%,
      rgba(220, 190, 120, 0.18),
      transparent 60%
    ),
    radial-gradient(
      500px 260px at 90% -20%,
      rgba(60, 200, 140, 0.18),
      transparent 70%
    ),
    repeating-linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.04) 0,
      rgba(255, 255, 255, 0.04) 1px,
      transparent 1px,
      transparent 8px
    );
  opacity: 0.7;
  pointer-events: none;
}

.table-page .brand h1 {
  margin: 0;
  font-family: "Fraunces", serif;
  font-weight: 750;
  font-size: clamp(26px, 2.5vw, 40px);
  line-height: 1.05;
  letter-spacing: 0.2px;
}

.table-page .detailsToggle {
  margin-top: 10px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(0, 0, 0, 0.2);
  color: rgba(255, 255, 255, 0.92);
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.table-page .detailsToggle span {
  font-weight: 700;
}

.table-page .detailsToggle.active {
  border-color: rgba(163, 126, 44, 0.45);
  background: rgba(163, 126, 44, 0.18);
  color: rgba(255, 236, 190, 0.95);
}

.table-page .detailsToggle:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.3);
}

.table-page .brand h1 .gold {
  color: var(--gold);
}

.table-page .addrBlock {
  margin-top: 10px;
  display: grid;
  gap: 14px;
  max-width: 720px;
  position: relative;
  z-index: 1;
}

.table-page .addrRow {
  display: grid;
  gap: 6px;
  color: rgba(255, 255, 255, 0.66);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.table-page .addrLabel {
  display: flex;
  align-items: center;
  gap: 8px;
}

.table-page .addrRow b {
  color: rgba(255, 255, 255, 0.84);
  font-weight: 700;
  letter-spacing: 0.06em;
}

.table-page .addrCard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: linear-gradient(
    120deg,
    rgba(10, 40, 28, 0.5),
    rgba(10, 10, 10, 0.2)
  );
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03),
    0 8px 20px rgba(0, 0, 0, 0.25);
}

.table-page .addrValue {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
    "Courier New", monospace;
  color: rgba(255, 255, 255, 0.86);
  letter-spacing: 0;
  text-transform: none;
  font-size: 12.5px;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.table-page .addrValue.reveal {
  overflow-x: auto;
  text-overflow: clip;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
}

.table-page .addrValue.reveal::-webkit-scrollbar {
  height: 6px;
}

.table-page .addrValue.reveal::-webkit-scrollbar-track {
  background: transparent;
}

.table-page .addrValue.reveal::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999px;
}

.table-page .addrActions {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.table-page .copyBtn {
  height: 30px;
  padding: 0 10px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.18);
  color: rgba(255, 255, 255, 0.92);
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.table-page .copyBtn.compact {
  padding: 0 12px;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.table-page .eyeBtn {
  height: 30px;
  width: 30px;
  padding: 0;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.18);
  color: rgba(255, 255, 255, 0.92);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.table-page .eyeBtn svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
}

.table-page .eyeBtn.active {
  background: rgba(163, 126, 44, 0.2);
  border-color: rgba(163, 126, 44, 0.45);
  color: rgba(255, 236, 190, 0.95);
}

.table-page .copyBtn:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.2);
}

.table-page .eyeBtn:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.2);
}

.table-page .status {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-top: 4px;
  position: relative;
  z-index: 1;
}

.table-page .pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.22);
  color: rgba(255, 255, 255, 0.85);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
}

@media (max-width: 720px) {
  .table-page .topbar {
    padding: 16px 14px 18px;
  }

  .table-page .addrBlock {
    gap: 12px;
  }

  .table-page .addrLabel {
    justify-content: space-between;
  }


  .table-page .addrCard {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .table-page .addrValue {
    width: 100%;
  }

  .table-page .addrActions {
    width: 100%;
    justify-content: flex-end;
  }

  .table-page .copyBtn.compact {
    height: 34px;
    padding: 0 14px;
  }

  .table-page .eyeBtn {
    height: 34px;
    width: 34px;
  }

  .table-page .status {
    width: 100%;
    justify-content: flex-start;
    gap: 8px;
  }

  .table-page .pill {
    flex: 1 1 auto;
    justify-content: center;
  }
}

.table-page .pill.gold {
  border-color: rgba(163, 126, 44, 0.32);
}

.table-page .dot {
  width: 8px;
  height: 8px;
  border-radius: 99px;
  background: rgba(110, 231, 183, 0.85);
  box-shadow: 0 0 0 3px rgba(110, 231, 183, 0.14);
}

.table-page .mono {
  letter-spacing: 0.06em;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
    "Courier New", monospace;
  text-transform: none;
}

.table-page .gridTop {
  margin-top: 16px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.table-page .gridBottom {
  margin-top: 14px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.table-page .card {
  border-radius: 22px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: linear-gradient(180deg, rgba(8, 18, 13, 0.62), rgba(8, 18, 13, 0.4));
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(16px);
  overflow: hidden;
  position: relative;
}

.table-page .card::before {
  content: "";
  position: absolute;
  inset: -150px -150px auto -150px;
  height: 280px;
  background: radial-gradient(circle at 30% 35%, rgba(163, 126, 44, 0.16), transparent 60%),
    radial-gradient(circle at 72% 35%, rgba(110, 231, 183, 0.14), transparent 58%);
  pointer-events: none;
}

.table-page .card > .inner {
  position: relative;
  padding: 16px 16px 14px;
}

.table-page .card h2 {
  margin: 0 0 10px;
  font-family: "Fraunces", serif;
  font-weight: 750;
  font-size: 22px;
  letter-spacing: 0.2px;
}

.table-page .kicker {
  margin: 0 0 12px;
  color: rgba(255, 255, 255, 0.66);
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  line-height: 1.35;
}

.table-page .gauge {
  margin: 8px auto 0;
  width: 180px;
  height: 180px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.06), rgba(0, 0, 0, 0.18));
  display: grid;
  place-items: center;
  position: relative;
}

.table-page .gauge::after {
  content: "";
  position: absolute;
  inset: 12px;
  border-radius: 999px;
  border: 1px solid rgba(163, 126, 44, 0.18);
  background: rgba(0, 0, 0, 0.1);
}

.table-page .gaugeContent {
  position: relative;
  text-align: center;
  display: grid;
  gap: 6px;
  padding: 0 12px;
}

.table-page .gaugeContent .small {
  color: rgba(255, 255, 255, 0.66);
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.table-page .gaugeAmount .amount {
  font-family: "Fraunces", serif;
  font-size: 44px;
  line-height: 1;
  letter-spacing: 0.4px;
}

.table-page .gaugeAmount .coin-icon {
  width: 26px;
  height: 26px;
}

.table-page .gaugeContent .foot {
  color: rgba(255, 255, 255, 0.6);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.table-page .stackTop {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-top: 6px;
}

.table-page .stackTop .big .amount {
  font-family: "Fraunces", serif;
  font-size: 40px;
  line-height: 1;
}

.table-page .stackTop .tag {
  color: rgba(255, 255, 255, 0.75);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.table-page .kv {
  margin-top: 12px;
  display: grid;
  gap: 8px;
  color: rgba(255, 255, 255, 0.8);
  font-size: 13px;
}

.table-page .kvRow {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 10px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(0, 0, 0, 0.14);
}

.table-page .actionBar {
  display: flex;
  align-items: center;
  gap: 10px;
}

.table-page input[type="range"] {
  width: 100%;
  accent-color: var(--gold);
}

.table-page .amtBox {
  width: 74px;
  height: 38px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.18);
  color: rgba(255, 255, 255, 0.92);
  padding: 0 10px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
    "Courier New", monospace;
  font-size: 13px;
  outline: none;
}

.table-page .amtBox:focus {
  box-shadow: 0 0 0 3px rgba(110, 231, 183, 0.35);
}

.table-page .chipRow {
  margin-top: 10px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.table-page .chip {
  border-radius: 999px;
  border: 1px solid rgba(163, 126, 44, 0.22);
  background: rgba(0, 0, 0, 0.16);
  color: rgba(255, 255, 255, 0.86);
  font-weight: 700;
  font-size: 12px;
  padding: 8px 10px;
  cursor: pointer;
  transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}

.table-page .chip:hover {
  transform: translateY(-1px);
  border-color: rgba(163, 126, 44, 0.4);
  background: rgba(255, 255, 255, 0.05);
}

.table-page .btnCol {
  margin-top: 12px;
  display: grid;
  gap: 10px;
}

.table-page .btn {
  height: 42px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.18);
  color: rgba(255, 255, 255, 0.92);
  font-weight: 800;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.table-page .btn:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
}

.table-page .btn.primary {
  border-color: rgba(163, 126, 44, 0.55);
  background: linear-gradient(180deg, rgba(163, 126, 44, 0.3), rgba(163, 126, 44, 0.16));
}

.table-page .btn.primary:hover {
  border-color: rgba(163, 126, 44, 0.75);
}

.table-page .btn.danger {
  border-color: rgba(255, 107, 107, 0.4);
  background: linear-gradient(180deg, rgba(255, 107, 107, 0.18), rgba(255, 107, 107, 0.08));
}

.table-page .splitRow {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 10px;
}

.table-page .pillSmall {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.16);
  color: rgba(255, 255, 255, 0.82);
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.table-page .feed {
  display: grid;
  gap: 10px;
  margin-top: 10px;
}

.table-page .feedItem {
  padding: 10px 10px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(0, 0, 0, 0.14);
  color: rgba(255, 255, 255, 0.82);
  font-size: 13px;
  line-height: 1.35;
}

.table-page .feedItem b {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 3px;
}

.table-page .feedItem span {
  color: rgba(255, 255, 255, 0.66);
  font-size: 12px;
}

.table-page .feedItem.error {
  border-color: rgba(224, 78, 78, 0.6);
  background: rgba(80, 16, 16, 0.35);
}

.table-page .feedItem.error b,
.table-page .feedItem.error span {
  color: rgba(255, 216, 216, 0.9);
}

.table-page .playersHdr {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
}

.table-page .playersHdr .count {
  font-family: "Fraunces", serif;
  font-size: 34px;
  line-height: 1;
}

.table-page .playerList {
  margin-top: 10px;
  display: grid;
  gap: 10px;
}

.table-page .player {
  padding: 10px 10px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(0, 0, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.table-page .pName {
  font-weight: 800;
}

.table-page .pMeta {
  margin-top: 4px;
  color: rgba(255, 255, 255, 0.66);
  font-size: 12px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}

@media (max-width: 1100px) {
  .table-page .gridTop {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .table-page .gridBottom {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .table-page .gridTop,
  .table-page .gridBottom {
    grid-template-columns: 1fr;
  }

  .table-page .status {
    justify-content: flex-start;
  }
}
